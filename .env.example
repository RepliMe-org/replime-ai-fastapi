# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Replime AI FastAPI
APP_VERSION=0.1.0

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret required on every internal endpoint (X-Internal-Token header).
X_INTERNAL_TOKEN=YOUR_INTERNAL_TOKEN

# ── Qdrant (vector store, shared cloud cluster) ───────────────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=replime_chunks

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
TRANSFORMERS_OFFLINE=1            # 0 to allow HuggingFace model downloads
HF_TOKEN=YOUR_HF_TOKEN            # optional — faster/authenticated downloads

# ── LLM providers (OpenAI-compatible endpoints) ───────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY
CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY
GEMINI_API_KEY=
NVIDIA_API_KEY=                   # NVIDIA NIM key (prefixed nvapi-), from build.nvidia.com

# Per-task model selection — format: provider/model (provider ∈ groq|cerebras|gemini|nvidia)
# NVIDIA ids contain their own "/", so they are double-prefixed: nvidia/<owner>/<model>
# Live chat pipeline → Groq (fast). Instruct-only: the client doesn't strip <think>,
# and these outputs are parsed (intent label / rewritten query / cited answer).
CHAT_MODEL=groq/llama-3.3-70b-versatile
REWRITE_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
INTENT_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
TITLE_MODEL=groq/llama-3.1-8b-instant
# Background / batch → NVIDIA NIM (higher quota, more powerful)
CLASSIFICATION_MODEL=nvidia/meta/llama-3.3-70b-instruct
DESCRIPTION_MODEL=nvidia/meta/llama-3.3-70b-instruct
ANALYTICS_MODEL=nvidia/openai/gpt-oss-120b

# Optional Arabic-corpus overrides — used only when a chatbot's indexed content
# is Arabic-dominant (see corpus_language_service.py). Leave blank to always use
# the base model above (no routing).
CHAT_MODEL_AR=groq/allam-2-7b
REWRITE_MODEL_AR=groq/allam-2-7b
DESCRIPTION_MODEL_AR=nvidia/qwen/qwen3-next-80b-a3b-instruct
ANALYTICS_MODEL_AR=nvidia/qwen/qwen3-next-80b-a3b-instruct
CORPUS_ARABIC_RATIO_THRESHOLD=0.1    # share of a chatbot's chunks that must be Arabic to route *_AR

# Per-task tuning
DESCRIPTION_SAMPLE_PER_VIDEO=6       # chunks sampled per video for description regeneration
DESCRIPTION_SAMPLE_MAX_CHARS=12000   # max total excerpt chars fed to the description regenerator
DESCRIPTION_LOCK_TTL_SECONDS=60      # per-chatbot lock TTL serializing description regeneration
ANALYTICS_MAX_QUESTIONS=300          # max questions sent to the analytics clusterer

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.4
RETRIEVAL_PREFETCH_LIMIT=20           # candidates per hybrid branch before RRF fusion
# MMR diversity-aware reranking
USE_MMR=true                     # false to return raw top-k without diversity reranking
MMR_LAMBDA=0.6                   # 1.0 = pure relevance, 0.0 = pure diversity
MMR_CANDIDATE_K=20               # candidate pool fetched before MMR selects top_k

# ── RabbitMQ (ingestion consumer — Spring Boot publishes here) ────────────────
RABBITMQ_HOST=localhost
RABBITMQ_USER=admin              # must match the broker's RABBITMQ_DEFAULT_USER
RABBITMQ_PASS=admin              # must match the broker's RABBITMQ_DEFAULT_PASS
MAX_RETRIES=3                    # attempts before a retryable error becomes permanent

# ── Redis (idempotency store — prevents duplicate indexing on redelivery) ─────
REDIS_HOST=localhost
REDIS_PORT=6379
IDEMPOTENCY_TTL_SECONDS=604800       # how long a processed idempotencyKey is remembered (7 days)

# ── Spring Boot backend (webhook callbacks) ───────────────────────────────────
SPRING_BOOT_BASE_URL=http://localhost:8080/api/v1

# ── YouTube transcript proxy ──────────────────────────────────────────────────
YOUTUBE_PROXY=http://LOGIN:PASSWORD@PROXY_HOST:823
