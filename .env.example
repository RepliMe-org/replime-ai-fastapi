# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Replime AI FastAPI
APP_VERSION=0.1.0

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret required on every internal endpoint (X-Internal-Token header).
X_INTERNAL_TOKEN=YOUR_INTERNAL_TOKEN

# ── Qdrant (vector store, shared cloud cluster) ───────────────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=replime_chunks

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
TRANSFORMERS_OFFLINE=1            # 0 to allow HuggingFace model downloads
HF_TOKEN=YOUR_HF_TOKEN            # optional — faster/authenticated downloads

# ── LLM providers (OpenAI-compatible endpoints) ───────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY
CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY
GEMINI_API_KEY=

# Per-task model selection — format: provider/model (provider ∈ groq|cerebras|gemini)
CHAT_MODEL=cerebras/gpt-oss-120b
REWRITE_MODEL=groq/llama-3.1-8b-instant
INTENT_MODEL=groq/llama-3.1-8b-instant
TITLE_MODEL=groq/llama-3.1-8b-instant
CLASSIFICATION_MODEL=groq/llama-3.1-8b-instant
DESCRIPTION_MODEL=groq/llama-3.1-8b-instant
ANALYTICS_MODEL=cerebras/gpt-oss-120b

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.4
# MMR diversity-aware reranking
USE_MMR=true                     # false to return raw top-k without diversity reranking
MMR_LAMBDA=0.6                   # 1.0 = pure relevance, 0.0 = pure diversity
MMR_CANDIDATE_K=20               # candidate pool fetched before MMR selects top_k

# ── RabbitMQ (ingestion consumer — Spring Boot publishes here) ────────────────
RABBITMQ_HOST=localhost
RABBITMQ_USER=admin              # must match the broker's RABBITMQ_DEFAULT_USER
RABBITMQ_PASS=admin              # must match the broker's RABBITMQ_DEFAULT_PASS
MAX_RETRIES=3                    # attempts before a retryable error becomes permanent

# ── Redis (idempotency store — prevents duplicate indexing on redelivery) ─────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Spring Boot backend (webhook callbacks) ───────────────────────────────────
SPRING_BOOT_BASE_URL=http://localhost:8080/api/v1

# ── YouTube-DL (video/audio downloader) ───────────────────────────────────────
YTDLP_COOKIES_FILE=E:\path\to\cookies.txt
